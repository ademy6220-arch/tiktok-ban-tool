async fn fetch_videos(sec_uid: &str, max_pages: u32, proxy: Option<&str>) -> Result<Vec<Video>> {
    let client = client_with_proxy(proxy)?;
    let mut cursor = 0i64;
    let mut all = Vec::new();
    for _ in 0..max_pages {
        let url = format!("{}/aweme/v1/aweme/post/?sec_user_id={}&count={}&max_cursor={}", API_BASE, sec_uid, VIDEO_PAGE_SIZE, cursor);
        let resp = client.get(&url)
            .header(USER_AGENT, random_ua())
            .send().await?;
        if !resp.status().is_success() { break; }
        let data: VideoListResponse = resp.json().await?;
        all.extend(data.aweme_list);
        if !data.has_more || data.max_cursor == 0 { break; }
        cursor = data.max_cursor;
    }
    Ok(all)
}


