struct ProxyPool {
    proxies: Vec<String>,
    index: usize,
    last_fetch: Instant,
    auto: bool,
}

impl ProxyPool {
    fn new(proxies: Vec<String>, auto: bool) -> Self {
        Self { proxies, index: 0, last_fetch: Instant::now(), auto }
    }

    async fn next(&mut self) -> Option<String> {
        if self.auto && self.last_fetch.elapsed() > Duration::from_secs(PROXY_REFRESH_INTERVAL) {
            if let Ok(new) = fetch_proxies_online(400).await {
                self.proxies = new;
                self.index = 0;
                self.last_fetch = Instant::now();
                println!("[kk3lly] Refreshed proxy pool ({} IPs)", self.proxies.len());
            }
        }
        if self.proxies.is_empty() { return None; }
        let p = self.proxies[self.index % self.proxies.len()].clone();
        self.index += 1;
        Some(p)
    }
}

// ─── PROXY FETCHING ────────────────────────────────────────────────
async fn fetch_proxies_online(count: usize) -> Result<Vec<String>> {
    let urls = [
        format!("https://api.proxyscrape.com/v2/?request=displayproxies&protocol=socks5&timeout=10000&country=all&limit={}", count),
        format!("https://www.proxy-list.download/api/v1/get?type=socks5&limit={}", count),
    ];
    let client = Client::new();
    let mut all = Vec::new();
    for url in urls {
        if let Ok(resp) = client.get(&url).timeout(Duration::from_secs(10)).send().await {
            if let Ok(body) = resp.text().await {
                for line in body.lines() {
                    let line = line.trim();
                    if !line.is_empty() && (line.contains(':') || line.starts_with("socks5://")) {
                        all.push(if line.starts_with("socks5://") { line.to_owned() } else { format!("socks5://{}", line) });
                    }
                }
            }
        }
    }
    Ok(all.into_iter().take(count).collect())
}

fn load_proxies_from_file(path: &str) -> Result<Vec<String>> {
    let reader = BufReader::new(File::open(path)?);
    let mut list = Vec::new();
    for line in reader.lines() {
        let line = line?;
        let trimmed = line.trim();
        if !trimmed.is_empty() {
            list.push(if trimmed.starts_with("socks5://") { trimmed.to_owned() } else { format!("socks5://{}", trimmed) });
        }
    }
    Ok(list)
}

// ─── HELPER: SECUID FROM USERNAME ─────────────────────────────────
async fn resolve_sec_uid(username: &str, proxy: Option<&str>) -> Result<String> {
    let url = format!("{}/aweme/v1/user/unique/?unique_id={}", API_BASE, username);
    let client = client_with_proxy(proxy)?;
    let resp = client.get(&url)
        .header(USER_AGENT, random_ua())
        .send().await?;
    let json: serde_json::Value = resp.json().await?;
    json["user"]["sec_uid"].as_str()
        .map(|s| s.to_owned())
        .ok_or_else(|| anyhow::anyhow!("secUID not found for @{}", username))
}

fn client_with_proxy(proxy: Option<&str>) -> Result<Client> {
    let mut b = Client::builder()
        .danger_accept_invalid_certs(true)
        .timeout(Duration::from_secs(10));
    if let Some(p) = proxy {
        b = b.proxy(Proxy::all(p)?);
    }
    Ok(b.build()?)
}

fn random_ua() -> &'static str {
    let mut rng = thread_rng();
    USER_AGENT_POOL.choose(&mut rng).unwrap()
}

